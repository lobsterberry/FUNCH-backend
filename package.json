{
  "name": "funch-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Car Rental System (FUNCH)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:fleet": "node scripts/test-fleet.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:fleet:migrate": "node scripts/migrate-fleet.mjs",
    "prisma:push": "prisma db push",
    "prisma:seed": "prisma db seed",
    "prisma:seed:fleet": "tsx scripts/seed-fleet.ts",
    "prisma:seed:check": "tsx prisma/seed.ts --dry-run",
    "prisma:studio": "prisma studio",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
