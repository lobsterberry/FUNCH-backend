{
  "name": "funch-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Backend API for Car Rental System (FUNCH)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:cars": "node --import tsx scripts/test-cars.mjs",
    "seed": "tsx scripts/seed/seed.ts",
    "seed:cars": "tsx scripts/seed-cars.ts",
    "seed:check": "tsx scripts/seed/seed.ts --dry-run",
    "db:migrate": "node --import tsx scripts/migrate-db.mjs",
    "db:migrate:cars": "node --import tsx scripts/migrate-cars.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "dependencies": {
    "@auth/express": "^0.12.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.4",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
