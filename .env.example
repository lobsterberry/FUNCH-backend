PORT=5000
NODE_ENV=development
AUTH_SECRET=
AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
# Set only when running behind a trusted reverse proxy, e.g. TRUST_PROXY_HOPS=1

# Set your database connection URL; use localhost for local Node.js or postgres in Docker.
# URL-encode special characters in the database password.
DATABASE_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=funch_db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=root
PGADMIN_PORT=5050

# Required only when creating demo users with prisma:seed (at least 12 characters).
SEED_USER_PASSWORD=

