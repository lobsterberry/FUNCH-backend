PORT=5000
NODE_ENV=development
AUTH_SECRET=
AUTH_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# URL-encode special characters in the database password.
# Use localhost and POSTGRES_PORT when running Node.js directly on the host.
DATABASE_URL=
# Use postgres:5432 when running the backend with Docker Compose.
DOCKER_DATABASE_URL=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=funch_db
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5050

# Optional password for new demo members (at least 12 characters). Defaults to a random password.
SEED_USER_PASSWORD=

