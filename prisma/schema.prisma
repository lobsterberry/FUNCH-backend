generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum DrivingSide {
  LEFT
  RIGHT
}

enum SteeringSide {
  RHD
  LHD
}

// Categories overlap: an electric SUV can appear in both SUV and EV filters.
enum CarCategory {
  SUV
  SEDAN
  MPV
  EV
  ECO
  LUXURY
  WAGON
}

enum TransmissionType {
  AUTOMATIC
  MANUAL
}

enum BookingSource {
  EXISTING_MEMBER
  REGISTER_AND_BOOK
}

model Country {
  code         String      @id @db.Char(2)
  name         String
  nameTh       String
  flag         String
  currencyCode String      @db.Char(3) // Local currency; rental rates below are quoted in THB.
  drivingSide  DrivingSide
  locations    Location[]
  cars         Car[]

  @@map("countries")
}

model Location {
  id          String    @id @default(uuid())
  name        String
  nameTh      String
  city        String
  cityTh      String
  countryCode String    @db.Char(2)
  timeZone    String // IANA zone per location, not per country (e.g. America/Los_Angeles).
  airportCode String?   @db.Char(3)
  country     Country   @relation(fields: [countryCode], references: [code])
  cars        Car[]
  pickups     Booking[] @relation("PickupLocation")
  dropoffs    Booking[] @relation("DropoffLocation")

  @@index([countryCode, city])
  @@map("locations")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  sessionVersion Int @default(0)
  name        String
  phoneNumber String?
  firstName   String?
  lastName    String?
  isActive    Boolean  @default(true)
  role        Role     @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings         Booking[] @relation("UserBookings")
  approvedBookings Booking[] @relation("AdminApprovedBookings")

  @@map("users")
}

model Car {
  id                  String           @id @default(uuid())
  brand               String
  model               String
  year                Int
  licensePlate        String
  country             String // เช่น 'TH', 'JP', 'US' รองรับการจองรถตามประเทศ
  hourlyRate          Decimal          @db.Decimal(12, 2)
  dailyRate           Decimal          @db.Decimal(12, 2)
  currencyCode        String           @default("THB") @db.Char(3)
  seats               Int              @default(4)
  transmission        String           @default("Automatic") // Automatic / Manual
  fuelType            String           @default("Gasoline") // Gasoline, EV, Hybrid, Diesel
  imageUrl            String?
  options             Json? // เช่น GPS, Child seat, Dashcam, Bluetooth
  // Keep display labels in options; use stable codes for hasEvery/hasSome filters.
  featureCodes        String[]         @default([])
  categories          CarCategory[]    @default([])
  categoryLabel       String?
  steeringSide        SteeringSide     @default(RHD)
  transmissionType    TransmissionType @default(AUTOMATIC)
  luggageCapacity     Int              @default(2)
  description         String?
  providerName        String?
  locationId          String?
  rating              Float            @default(0)
  reviewCount         Int              @default(0)
  badge               String?
  isFeatured          Boolean          @default(false)
  recommendationOrder Int              @default(100)
  isAvailable         Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  bookings    Booking[]
  countryInfo Country   @relation(fields: [country], references: [code])
  location    Location? @relation(fields: [locationId], references: [id])

  @@unique([country, licensePlate])
  @@index([country, isAvailable, locationId])
  @@index([categories], type: Gin)
  @@index([featureCodes], type: Gin)
  @@map("cars")
}

model Booking {
  id            String   @id @default(uuid())
  bookingNumber String   @unique @default(cuid())
  userId        String
  carId         String
  startDateTime DateTime
  endDateTime   DateTime

  // Pricing Calculation Results ตาม Pricing Rules ใน Assignment.md
  calculatedDays             Int           @default(0)
  calculatedHours            Int           @default(0)
  totalPrice                 Decimal       @db.Decimal(12, 2)
  pricingDetails             Json? // รายละเอียดแจกแจงการคำนวณ
  // Historical price/time-zone snapshots survive later edits to a car/location.
  hourlyRate                 Decimal?      @db.Decimal(12, 2)
  dailyRate                  Decimal?      @db.Decimal(12, 2)
  currencyCode               String        @default("THB") @db.Char(3)
  timeZone                   String        @default("UTC")
  driverName                 String?
  internationalDrivingPermit String?
  pickupLocationId           String?
  dropoffLocationId          String?
  source                     BookingSource @default(EXISTING_MEMBER)

  status       BookingStatus @default(PENDING)
  adminNote    String?
  approvedById String?
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User      @relation("UserBookings", fields: [userId], references: [id])
  car             Car       @relation(fields: [carId], references: [id])
  approvedBy      User?     @relation("AdminApprovedBookings", fields: [approvedById], references: [id])
  pickupLocation  Location? @relation("PickupLocation", fields: [pickupLocationId], references: [id])
  dropoffLocation Location? @relation("DropoffLocation", fields: [dropoffLocationId], references: [id])

  @@index([carId, status, startDateTime, endDateTime])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("bookings")
}
